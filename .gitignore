# Firebase — google-services.json contains API keys, keep out of public repos
android/app/google-services.json

# iOS build artifacts
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/.generated/
ios/Flutter/App.framework
ios/Pods/
ios/.symlinks/
ios/Runner/GeneratedPluginRegistrant.*

# macOS
macos/Flutter/GeneratedPluginRegistrant.swift
macos/Flutter/ephemeral/

# Windows / Linux
windows/flutter/generated_plugin_registrant.cc
windows/flutter/generated_plugin_registrant.h
windows/flutter/generated_plugins.cmake
linux/flutter/generated_plugin_registrant.cc
linux/flutter/generated_plugin_registrant.h
linux/flutter/generated_plugins.cmake

# pubspec.lock — for apps (not packages) you CAN commit this.
# It ensures everyone gets the same dependency versions.
# pubspec.lock  ← leave commented out, we commit it

# Generated mock files (created by build_runner)
# Some teams commit these, some regenerate on CI.
# We commit them so the project works out of the box without running build_runner.
# **/*.mocks.dart  ← leave commented out, we commit mocks

# Workspace file (machine-specific, not needed in repo)
*.code-workspace
